# ── CUDAQuant-Jetson Environment Configuration ────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# ── Trading mode ────────────────────────────────────────────────────────────
# paper | live
# LIVE TRADING REQUIRES ADDITIONAL EXPLICIT GATES (see docs).
TRADING_MODE=paper
# Only set this to "I_UNDERSTAND_LIVE_TRADING_RISK" if you truly intend live.
ENABLE_LIVE_TRADING=no

# ── Alpaca ──────────────────────────────────────────────────────────────────
# ALPACA_API_KEY=your_key_here
# ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex   # iex (free) or sip (paid)

# ── LLM (optional — system works fully without it) ─────────────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_DAILY_BUDGET_USD=1.00
# LLM_MONTHLY_BUDGET_USD=20.00
# LLM_MAX_CALLS_PER_DAY=50
# LLM_MAX_TOKENS_PER_CALL=8000

# ── Alerts (optional — Telegram alerts are silently skipped if unset) ──────
# Create a bot via @BotFather, then send it a message and get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# ── Jetson / GPU ────────────────────────────────────────────────────────────
# CUDA_ENABLED=true        # auto-detected if blank
# GPU_BACKTEST_BATCH_SIZE=1024

# ── Storage ─────────────────────────────────────────────────────────────────
# DATA_DIR=./data
# DUCKDB_PATH=./data/cudaquant.duckdb

# ── Server ──────────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# API_AUTH_TOKEN=change-me-to-a-random-secret  # REQUIRED when HOST!=127.0.0.1

# ── Risk limits (paper defaults) ────────────────────────────────────────────
# MAX_POSITION_NOTIONAL=100000
# MAX_TOTAL_EXPOSURE=500000
# MAX_DAILY_TRADES=50
# MAX_DAILY_LOSS=5000
# MAX_DRAWDOWN_PCT=20
# KILL_SWITCH_FILE=./.kill_switch
